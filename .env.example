FRONTIEROPS_ENVIRONMENT=local
FRONTIEROPS_LOG_LEVEL=INFO
FRONTIEROPS_API_HOST=0.0.0.0
FRONTIEROPS_API_PORT=8000
FRONTIEROPS_DATABASE_URL=postgresql+asyncpg://frontierops:frontierops@postgres:5432/frontierops
FRONTIEROPS_REDIS_URL=redis://redis:6379/0
FRONTIEROPS_OLLAMA_BASE_URL=http://ollama:11434
FRONTIEROPS_OLLAMA_KEEP_ALIVE=5m
FRONTIEROPS_PROVIDER_TIMEOUT_SECONDS=120
FRONTIEROPS_TELEMETRY_ENABLED=true
FRONTIEROPS_OTLP_ENDPOINT=http://otel-collector:4318
FRONTIEROPS_TRACE_SAMPLE_RATIO=1.0
FRONTIEROPS_WORKER_METRICS_PORT=9000
GRAFANA_ADMIN_PASSWORD=change-me
FRONTIEROPS_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173"]
SERVICENOW_ENABLED=false
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=frontierops-integration-user
SERVICENOW_PASSWORD=replace-with-secret
SERVICENOW_INCIDENT_TABLE=incident
FRONTIEROPS_AWS_REGION=us-east-1
FRONTIEROPS_S3_REPORTS_BUCKET=frontierops-local
FRONTIEROPS_S3_ENDPOINT_URL=http://localstack:4566
FRONTIEROPS_CLOUDWATCH_METRICS_ENABLED=false
FRONTIEROPS_CLOUDWATCH_NAMESPACE=FrontierOps
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
